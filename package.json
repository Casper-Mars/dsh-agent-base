{
  "name": "dsh-agent-base",
  "version": "0.1.0",
  "type": "module",
  "description": "固定 Workspace 与 main session id 的基础插件（dsh）：只提供身份与路径，不创建 Agent、不投递消息",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "agent-base"
  ],
  "author": "Casper <solitaryreach@163.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.7.0"
  },
  "main": "dist-server/index.js",
  "exports": {
    ".": {
      "types": "./dist-server/types/index.d.ts",
      "default": "./dist-server/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-server/**/*.js",
    "dist-server/types/**/*.d.ts",
    "dist-server/cordis.patch.yml",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && pnpm typecheck && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:server": "pnpm clean && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:consumer": "tsc -p tsconfig.consumer.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist dist-server",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
